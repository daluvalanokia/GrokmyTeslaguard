@{
    ViewData["Title"] = "MyTeslaGuard Navigation";
}

<div class="map-app">
    <!-- Full-screen map -->
    <div id="map" class="map-container"></div>

    <!-- Transparent HUD Overlay -->
    <div class="hud-overlay">
        <!-- Top bar: destination + controls + vehicle status -->
        <div class="nav-top">
            <div class="dest-row">
                <input type="text" id="destinationInput" class="dest-input"
                       placeholder="Enter destination address..." autocomplete="off" />
                <label class="avoid-highways">
                    <input type="checkbox" id="avoidHighways" />
                    <span>Avoid Highways</span>
                </label>
                <button id="goBtn" class="go-btn">Go</button>
            </div>
            <div class="status-row">
                <span class="app-title">MyTeslaGuard</span>
                <span class="status" id="connectionStatus">Connecting...</span>
                <span class="nav-status" id="navStatus">Ready</span>
            </div>

            <!-- Vehicle status: charge / range + tire pressures (top corner style) -->
            <div class="vehicle-status">
                <div class="vs-item charge" title="Battery / Range">
                    <span class="vs-icon">🔋</span>
                    <span class="vs-value" id="batteryPct">--%</span>
                    <span class="vs-sub" id="rangeMiles">-- mi</span>
                </div>
                <div class="vs-item tires" title="Tire pressures (PSI)">
                    <span class="vs-icon">🛞</span>
                    <div class="tire-grid">
                        <span class="tire" id="tpFl">FL --</span>
                        <span class="tire" id="tpFr">FR --</span>
                        <span class="tire" id="tpRl">RL --</span>
                        <span class="tire" id="tpRr">RR --</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Speed gauges (compact for overlay) -->
        <div class="hud-gauges">
            <div class="circle-gauge posted" id="postedCircle">
                <div class="circle-value" id="postedSpeed">--</div>
                <div class="circle-label">POSTED</div>
            </div>
            <div class="circle-gauge current" id="currentCircle">
                <div class="circle-value" id="currentSpeed">--</div>
                <div class="circle-label">MY SPEED</div>
            </div>
        </div>

        <!-- Overspeed bar -->
        <div class="hud-overspeed">
            <div class="overspeed-bar" id="overspeedBar">
                <div class="band white" data-band="white">0-5</div>
                <div class="band yellow" data-band="yellow">5-10</div>
                <div class="band orange" data-band="orange">10-15</div>
                <div class="band red" data-band="red">15+</div>
            </div>
            <div class="over-value" id="overValue">Within limit</div>
        </div>

        <!-- Bottom controls (collapsible / compact) -->
        <div class="hud-bottom">
            <div class="beep-toggles">
                <label><input type="checkbox" id="beepEnabled" checked /> Beeps</label>
                <label><input type="checkbox" id="beepOrange" checked /> Orange</label>
                <label><input type="checkbox" id="beepRed" checked /> Red</label>
            </div>
            <div class="demo-buttons">
                <button onclick="setScenario('city')">City</button>
                <button onclick="setScenario('highway')">Hwy</button>
                <button onclick="setScenario('overspeed')">Over</button>
            </div>
            <div class="info" id="lastUpdate">--</div>
        </div>
    </div>
</div>
